# MongoDB Atlas Connection String
# Get your free cluster at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster-url>/silver_caterers?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/silver_caterers?retryWrites=true&w=majority

# Secret for signing JWT authentication tokens (use a random string in production)
JWT_SECRET=silver_catering_jwt_secret_super_secure_key_2026
